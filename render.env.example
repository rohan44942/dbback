# Render environment variables for dbback-api
# Copy this file to render.env, fill in your values, then import in Render:
#   Dashboard → dbback-api → Environment → "Add from .env"
#
# Do NOT commit render.env (real secrets). This file is safe to commit.

# --- Required ---

DBBACK_ENV=production

# Neon: use Pooled connection string from console.neon.tech → Connect
DBBACK_DATABASE_URL=postgresql://USER:PASSWORD@ep-XXXX-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Generate a long random string (64+ chars). Do not use the dev default.
DBBACK_AUTH_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET

# Your Netlify frontend URL (comma-separate multiple origins if needed)
DBBACK_CORS_ORIGIN=https://dbbackup.netlify.app

# --- S3 storage (required for production backups) ---

# Region must match your S3 bucket (check AWS Console → bucket → Properties → Region)

DBBACK_STORAGE_TYPE=s3
DBBACK_STORAGE_BUCKET=your-bucket-name
DBBACK_STORAGE_REGION=ap-southeast-2
DBBACK_STORAGE_ENDPOINT=s3.ap-southeast-2.amazonaws.com
DBBACK_STORAGE_ACCESS_KEY=YOUR_AWS_ACCESS_KEY
DBBACK_STORAGE_SECRET_KEY=YOUR_AWS_SECRET_KEY
DBBACK_STORAGE_USE_SSL=true

# --- Optional ---

DBBACK_RETENTION_DAYS=7

# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# Leave unset on Render — the app uses Render's PORT automatically.
# DBBACK_ADDR=:8080
